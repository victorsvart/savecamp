R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Optional. When set, clients must send Authorization: Bearer <secret>
SAVECAMP_API_SECRET=
# PostgreSQL connection string (Prisma 8). Requires PostgreSQL >= 15.
# Matches apps/api/docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/savecamp
