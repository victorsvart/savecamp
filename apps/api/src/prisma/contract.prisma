// use prisma-next
model Camp {
  id        String               @id @default(uuid())
  name      String
  gameId    String
  game      Game                 @relation(fields:[gameId], references:[id])
  creatorId String
  creator   User                 @relation(fields:[creatorId], references:[id])
  members   CampMember[]
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@unique([gameId, creatorId])
  @@index([gameId])
  @@map("camps")
}

model CampMember {
  id        String               @id @default(uuid())
  campId    String
  camp      Camp                 @relation(fields:[campId], references:[id])
  memberId  String
  member    User                 @relation(fields:[memberId], references:[id])
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@unique([campId, memberId])
  @@map("camp_members")
}

model User {
  id        String               @id @default(uuid())
  // clerkId deveria vim aqui
  camps     Camp[]
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@map("users")
}

model Game {
  id        String               @id @default(uuid())
  name      String
  logoURL   String
  slug      String               @unique @default("change-me")
  active    Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@map("games")
}

model GameCampSave {
  id        String               @id @default(uuid())
  campId    String
  camp      Camp                 @relation(fields:[campId], references:[id])
  data      Json                 @default("{}")
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()

  @@map("game_camp_saves")
}
