{
  "name": "@savecamp/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@savecamp/types": "workspace:*",
    "hono": "^4.13.5",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "8.0.0-rc.12",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
